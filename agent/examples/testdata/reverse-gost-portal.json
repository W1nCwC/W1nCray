{
  "version": 1,
  "revision": 1,
  "instances": [
    {
      "id": "gost-rev",
      "name": "gost反向代理公网端（portal）：wss控制链路，与bridge文件成对",
      "enabled": true,
      "engine": "gost",
      "kind": "reverse_portal",
      "listen": { "addr": "0.0.0.0", "ports": "21400" },
      "network": ["tcp"],
      "tunnel": {
        "type": "wss",
        "listen": "0.0.0.0:21401",
        "host": "relay.example.com",
        "path": "/gost-rev",
        "cert": {
          "mode": "file",
          "cert_file": "/etc/ssl/relay/fullchain.pem",
          "key_file": "/etc/ssl/relay/privkey.pem"
        }
      },
      "reverse": { "link": "gost-rev" },
      "secret": "CHANGE-ME-32-chars-minimum-secret"
    }
  ]
}
