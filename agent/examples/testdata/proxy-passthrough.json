{
  "version": 1,
  "revision": 1,
  "instances": [
    {
      "id": "proxy-pass",
      "name": "PROXY透传：回环接收头，再向目标发送v2头，保留真实来源",
      "enabled": true,
      "engine": "xray",
      "kind": "forward",
      "listen": { "addr": "127.0.0.1", "ports": "20620" },
      "network": ["tcp"],
      "targets": [{ "host": "203.0.113.62", "ports": "443" }],
      "accept_proxy_protocol": true,
      "proxy_protocol_out": 2
    }
  ]
}
