{
  "version": 1,
  "revision": 1,
  "instances": [
    {
      "id": "gost-limited",
      "name": "gost转发：连接数与带宽限制，被动摘除故障目标的主备",
      "enabled": true,
      "engine": "gost",
      "kind": "forward",
      "listen": { "addr": "0.0.0.0", "ports": "20500" },
      "network": ["tcp"],
      "targets": [
        { "host": "203.0.113.14", "ports": "443" },
        { "host": "203.0.113.15", "ports": "443" }
      ],
      "balance": {
        "strategy": "failover",
        "health": { "type": "tcp", "interval_s": 30, "max_fails": 3 }
      },
      "limits": { "max_conns": 200, "rate_up_bps": 8000000, "rate_down_bps": 8000000 }
    }
  ]
}
