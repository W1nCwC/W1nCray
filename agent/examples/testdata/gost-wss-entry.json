{
  "version": 1,
  "revision": 1,
  "instances": [
    {
      "id": "gost-tun",
      "name": "gost隧道入口（机器A）：wss，目标由出口决定，与exit文件成对",
      "enabled": true,
      "engine": "gost",
      "kind": "tunnel_entry",
      "listen": { "addr": "0.0.0.0", "ports": "21200" },
      "network": ["tcp"],
      "tunnel": {
        "type": "wss",
        "server": "relay.example.com:21201",
        "host": "relay.example.com",
        "sni": "relay.example.com",
        "path": "/gost"
      },
      "secret": "CHANGE-ME-32-chars-minimum-secret"
    }
  ]
}
