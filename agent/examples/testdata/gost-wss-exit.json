{
  "version": 1,
  "revision": 1,
  "instances": [
    {
      "id": "gost-tun",
      "name": "gost隧道出口（机器B）：只放行声明的目标，与entry文件成对",
      "enabled": true,
      "engine": "gost",
      "kind": "tunnel_exit",
      "network": ["tcp"],
      "targets": [{ "host": "203.0.113.91", "ports": "443" }],
      "tunnel": {
        "type": "wss",
        "listen": "0.0.0.0:21201",
        "host": "relay.example.com",
        "path": "/gost",
        "cert": {
          "mode": "file",
          "cert_file": "/etc/ssl/relay/fullchain.pem",
          "key_file": "/etc/ssl/relay/privkey.pem"
        }
      },
      "secret": "CHANGE-ME-32-chars-minimum-secret"
    }
  ]
}
